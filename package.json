{
  "name": "minerx",
  "private": true,
  "version": "1.2.2",
  "description": "MinerX - Telemetría Kryptex PRL & Flota SaladCloud GPU",
  "author": "Roman",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,emerald\" \"tsx watch server/server.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-concurrency=1 test/unit/profitabilityService.test.ts test/unit/vastOffersService.test.ts test/unit/strategyEngine.test.ts test/unit/miningVisualizationService.test.ts test/unit/commercialPackagesSync.test.ts test/unit/userManagementSync.test.ts test/unit/scrum210SchemaRules.test.ts test/unit/scrum211SafeSeed.test.ts test/unit/scrum212CatalogService.test.ts test/unit/scrum217FirebaseAdminAdapter.test.ts test/unit/scrum217PackageBuilderCanonicalCrud.test.ts test/unit/scrum222FirebaseAuthConvergence.test.ts",
    "test:firebase-admin:live-read": "node --import tsx test/integration/scrum217LiveReadSmoke.test.ts",
    "seed:packages": "node --import tsx scripts/safeSeedPackages.ts",
    "start": "tsx server/server.ts",
    "electron:dev": "concurrently -n \"SERVER,CLIENT,ELECTRON\" -c \"cyan,emerald,magenta\" \"tsx watch server/server.ts\" \"vite\" \"electron .\"",
    "build:exe": "npm run build && electron-builder --win --dir",
    "build:exe:installer": "npm run build && electron-builder --win nsis",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "electronBuilder": {
    "appId": "com.minerx.telemetry",
    "productName": "MinerX",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/downloads/**",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MinerX Telemetry",
      "uninstallDisplayName": "MinerX Telemetry & Fleet Management"
    }
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "concurrently": "^10.0.6",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "^1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
