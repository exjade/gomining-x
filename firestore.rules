rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MinerX Cloud Telemetry & Platform Administration Security Rules
    // Completely isolated from GoMining client collections (/users, /miners, /referrals)

    // Colección de Administradores y Operadores de la Plataforma
    match /admin_users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Colección de Usuarios y Clientes de la Plataforma (/users)
    match /users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Colección de Flota de Workers y Racks
    match /admin_workers/{workerId} {
      allow read, write: if true;
    }

    // Contratos y Asignaciones Administrativas
    match /admin_contracts/{contractId} {
      allow read, write: if true;
    }

    // Registro de Auditoría de la Plataforma
    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }

    // Ajustes y Configuración de MinerX
    match /admin_settings/{settingId} {
      allow read, write: if true;
    }

    // Paquetes comerciales de minería disponibles para la plataforma
    match /commercial_packages/{packageId} {
      allow read, write: if true;
    }

    // Órdenes y pagos de paquetes
    match /admin_orders/{orderId} {
      allow read, write: if true;
    }

    // Compatibilidad retroactiva con minerx_*
    match /minerx_users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /minerx_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /minerx_app_data/{docId} {
      allow read, write: if true;
    }
  }
}
