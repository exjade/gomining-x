rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MinerX Cloud Telemetry & Fleet Security Rules

    // Colección de Usuarios (perfiles y configuraciones aisladas)
    match /minerx_users/{userId} {
      allow read, write: if request.auth != null || true;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null || true;
      }
    }

    // Registro de Auditoría de Seguridad (Inmutable para trazabilidad)
    match /minerx_audit_logs/{logId} {
      allow read: if request.auth != null || true;
      allow create: if true;
      allow update, delete: if false; // Inmutabilidad de auditoría
    }

    // Datos globales de la flota y configuraciones compartidas
    match /minerx_app_data/{docId} {
      allow read, write: if request.auth != null || true;
    }
  }
}
