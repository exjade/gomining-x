rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validDemoSnapshot() {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'mode', 'balance', 'miners', 'workers',
          'workerActivationMode', 'pendingMinerOrders', 'subscription',
          'receipts', 'presaleTokens', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'mode', 'balance', 'miners', 'workers',
          'workerActivationMode', 'pendingMinerOrders', 'subscription',
          'receipts', 'presaleTokens', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.mode == 'demo'
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000
        && request.resource.data.miners is list
        && request.resource.data.miners.size() <= 100
        && request.resource.data.workers is list
        && request.resource.data.workers.size() <= 100
        && request.resource.data.pendingMinerOrders is list
        && request.resource.data.pendingMinerOrders.size() <= 100
        && request.resource.data.receipts is list
        && request.resource.data.receipts.size() <= 50
        && request.resource.data.presaleTokens is number
        && request.resource.data.presaleTokens >= 0
        && request.resource.data.workerActivationMode in ['automatic', 'manual']
        && (request.resource.data.subscription == null || request.resource.data.subscription is map)
        && request.resource.data.updatedAt == request.time;
    }

    // User document for authentication, profile, wallet linking, and referral tree
    match /users/{uid} {
      // Public read to allow sponsor referral code lookup before and during signup
      allow read: if true;
      // Authenticated users can only create their own user document
      allow create: if isAuthenticated() && request.auth.uid == uid;
      // Authenticated users can update their own profile, or update referral/commission fields on a sponsor document
      allow update: if isAuthenticated() && (
        request.auth.uid == uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'referral', 'commissionBalance', 'balance', 'totalCommissionsEarned',
          'purchasesCount', 'lastPurchaseAt', 'firstPurchaseAt', 'sponsorId'
        ])
      );
      allow delete: if false;

      // Demo state per browser/session
      match /demoState/{docId} {
        allow read: if isOwner(uid) && docId == 'current';
        allow create, update: if isOwner(uid) && docId == 'current' && validDemoSnapshot();
        allow delete: if false;
      }
    }

    // Isolated miner storage per authenticated user
    match /miners/{uid}/miner/{minerId} {
      allow read, write: if isOwner(uid);
      allow delete: if false;
    }

    // Referral commission records
    match /referralCommissions/{commissionId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Dedicated referrals collection for financial accounting (1nvezt pattern)
    match /referrals/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;

      match /transactions/{txId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if false;
      }
    }

    // Dedicated unilevel network collection per user (tree node & upline chain)
    match /unilevel/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;

      match /{subcol=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // Daily mining profit accounting
    match /mining_daily_profit/{profitId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Unilevel 20-levels distribution records (Notion Technical Plan)
    match /unilevel_distributions/{distributionId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Dedicated country detection collection per user
    match /countries/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Dedicated isolated collections for platform administration (MinerX)
    // Completely separated from client-facing GoMining collections
    match /admin_users/{userId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    match /admin_workers/{workerId} {
      allow read, write: if true;
    }

    match /admin_contracts/{contractId} {
      allow read, write: if true;
    }

    match /admin_audit_logs/{logId} {
      allow read, write: if true;
    }

    match /admin_settings/{settingId} {
      allow read, write: if true;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
